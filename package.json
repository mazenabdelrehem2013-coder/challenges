{
  "name": "challenges",
  "private": true,
  "type": "module",
  "description": "Employee challenges app on Firebase: phone app (mobile/), manager and HR dashboard (dashboard/), shared game rules (shared/) and database rules (firestore.rules).",
  "scripts": {
    "test": "node --test 'tests/game.test.js' && firebase emulators:exec --only firestore,auth --project demo-challenges \"node --test 'tests/rules.test.js'\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-challenges"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.33.0"
  }
}
